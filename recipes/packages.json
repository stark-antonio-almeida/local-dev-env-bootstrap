  "ssh": {
    "ubuntu": {
      "manager": "script",
      "script": "ssh.sh",
      "validation": [
        "test -f ~/.ssh/config",
        "test -f ~/.ssh/id_ed25519",
        "test -f ~/.ssh/id_ed25519.pub"
      ]
    }
  },
  "stow-config": {
    "ubuntu": {
      "manager": "script",
      "script": "stow.sh",
      "validation": [
        "test -L ~/.config/nvim"
      ]
    }
  }

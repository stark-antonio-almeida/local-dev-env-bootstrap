{
  "snap-bootstrap": {
    "ubuntu": {
      "manager": "custom",
      "install": [
        "grep -q '/snap/bin' ~/.profile || echo 'export PATH=\"/snap/bin:$PATH\"' >> ~/.profile",
        "export PATH=\"/snap/bin:$PATH\""
      ],
      "validation": [
        "echo $PATH | grep /snap/bin"
      ]
    }
  },
  "git": {
    "ubuntu": {
      "manager": "apt",
      "pre": [
        "sudo add-apt-repository ppa:git-core/ppa -y",
        "sudo apt update"
      ],
      "post": [
        "git config --global core.eol lf",
        "git config --global core.autocrlf false"
      ],
      "package": "git",
      "validation": [
        "git --version"
      ]
    },
    "windows11": {
      "manager": "winget",
      "package": "Git.Git",
      "validation": [
        "git --version"
      ]
    }
  },
  "build-essential": {
    "ubuntu": {
      "manager": "apt",
      "package": "build-essential",
      "validation": [
        "cc --version"
      ]
    }
  },
  "clang": {
    "ubuntu": {
      "manager": "apt",
      "package": "clang",
      "validation": [
        "clang --version"
      ]
    }
  },
  "libclang": {
    "ubuntu": {
      "manager": "apt",
      "package": "libclang-dev",
      "validation": [
        "dpkg -s libclang-dev"
      ]
    }
  },
  "rust": {
    "ubuntu": {
      "manager": "custom",
      "pre": [
        "grep -q '.cargo/bin' ~/.profile || echo 'export PATH=\"$HOME/.cargo/bin:$PATH\"' >> ~/.profile"
      ],
      "install": [
        "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y"
      ],
      "post": [
        ". \"$HOME/.cargo/env\"",
        "source ~/.profile"
      ],
      "validation": [
        "rustc --version",
        "cargo --version"
      ]
    }
  },
  "dotnet": {
    "ubuntu": {
      "manager": "apt",
      "pre": [
        "sudo add-apt-repository ppa:dotnet/backports -y",
        "sudo apt update"
      ],
      "package": "dotnet-sdk-10.0",
      "validation": [
        "dotnet --info"
      ]
    },
    "windows11": {
      "manager": "winget",
      "package": "Microsoft.DotNet.SDK.8",
      "validation": [
        "dotnet --info"
      ]
    }
  },
  "neovim": {
    "ubuntu": {
      "manager": "snap",
      "package": "nvim",
      "flags": [
        "--classic"
      ],
      "validation": [
        "nvim --version"
      ]
    }
  },
  "nushell": {
    "ubuntu": {
      "manager": "snap",
      "package": "nushell",
      "flags": [
        "--classic"
      ],
      "validation": [
        "nu --version"
      ]
    },
    "windows11": {
      "manager": "winget",
      "package": "Nushell.Nushell",
      "validation": [
        "nu --version"
      ]
    }
  },
  "ghostty": {
    "ubuntu": {
      "manager": "snap",
      "package": "ghostty",
      "flags": [
        "--classic"
      ],
      "validation": [
        "ghostty --version"
      ]
    }
  },
  "ripgrep": {
    "ubuntu": {
      "manager": "cargo",
      "package": "ripgrep",
      "validation": [
        "rg --version"
      ]
    },
    "windows11": {
      "manager": "winget",
      "package": "BurntSushi.ripgrep.MSVC",
      "validation": [
        "rg --version"
      ]
    }
  },
  "tree-sitter-cli": {
    "ubuntu": {
      "manager": "cargo",
      "package": "tree-sitter-cli",
      "validation": [
        "tree-sitter --version"
      ]
    }
  },
  "fzf": {
    "ubuntu": {
      "manager": "apt",
      "package": "fzf",
      "validation": [
        "fzf --version"
      ]
    },
    "windows11": {
      "manager": "winget",
      "package": "junegunn.fzf",
      "validation": [
        "fzf --version"
      ]
    }
  },
  "eza": {
    "ubuntu": {
      "manager": "apt",
      "package": "eza",
      "validation": [
        "eza --version"
      ]
    },
    "windows11": {
      "manager": "winget",
      "package": "eza-community.eza",
      "validation": [
        "eza --version"
      ]
    }
  },
  "lazygit": {
    "ubuntu": {
      "manager": "custom",
      "install": [
        "LAZYGIT_VERSION=$(curl -s https://api.github.com/repos/jesseduffield/lazygit/releases/latest | jq -r .tag_name)",
        "curl -Lo lazygit.tar.gz https://github.com/jesseduffield/lazygit/releases/latest/download/lazygit_${LAZYGIT_VERSION#v}_Linux_x86_64.tar.gz",
        "tar xf lazygit.tar.gz lazygit",
        "sudo install lazygit /usr/local/bin"
      ],
      "validation": [
        "lazygit --version"
      ]
    },
    "windows11": {
      "manager": "winget",
      "package": "JesseDuffield.lazygit",
      "validation": [
        "lazygit --version"
      ]
    }
  },
  "yazi": {
    "ubuntu": {
      "manager": "custom",
      "install": [
        "cargo install --force --git https://github.com/sxyazi/yazi.git yazi-build",
        "cargo install --git https://github.com/sxyazi/yazi.git yazi-fm"
      ],
      "validation": [
        "yazi --version"
      ]
    },
    "windows11": {
      "manager": "winget",
      "package": "sxyazi.yazi",
      "validation": [
        "yazi --version"
      ]
    }
  },
  "fd": {
    "windows11": {
      "manager": "winget",
      "package": "sharkdp.fd",
      "validation": [
        "fd --version"
      ]
    }
  },
  "jq": {
    "windows11": {
      "manager": "winget",
      "package": "jqlang.jq",
      "validation": [
        "jq --version"
      ]
    }
  },
  "yq": {
    "windows11": {
      "manager": "winget",
      "package": "MikeFarah.yq",
      "validation": [
        "yq --version"
      ]
    }
  },
  "zoxide": {
    "windows11": {
      "manager": "winget",
      "package": "ajeetdsouza.zoxide",
      "validation": [
        "zoxide --version"
      ]
    }
  },
  "delta": {
    "windows11": {
      "manager": "winget",
      "package": "dandavison.delta",
      "validation": [
        "delta --version"
      ]
    }
  },
  "glow": {
    "windows11": {
      "manager": "winget",
      "package": "charmbracelet.glow",
      "validation": [
        "glow --version"
      ]
    }
  },
  "starship": {
    "windows11": {
      "manager": "winget",
      "package": "Starship.Starship",
      "validation": [
        "starship --version"
      ]
    },
    "ubuntu": {
      "manager": "custom",
      "install": [
        "curl -sS https://starship.rs/install.sh | sh -s -- -y"
      ],
      "validation": [
        "starship --version"
      ]
    }
  },
  "go": {
    "windows11": {
      "manager": "winget",
      "package": "GoLang.Go",
      "validation": [
        "go version"
      ]
    }
  },
  "python": {
    "windows11": {
      "manager": "winget",
      "package": "Python.Python.3.13",
      "validation": [
        "python --version"
      ]
    }
  },
  "gh": {
    "windows11": {
      "manager": "winget",
      "package": "GitHub.cli",
      "validation": [
        "gh --version"
      ]
    }
  },
  "wsl": {
    "windows11": {
      "manager": "winget",
      "package": "Microsoft.WSL",
      "validation": [
        "wsl --version"
      ]
    }
  },
  "stow": {
    "ubuntu": {
      "manager": "apt",
      "package": "stow",
      "validation": [
        "stow --version"
      ]
    }
  }
}

{
  "snap-bootstrap": {
    "ubuntu": {
      "manager": "custom",
      "install": [
        "sudo if ! grep -q '/snap/bin' ~/.profile; then echo 'export PATH=\"/snap/bin:$PATH\"' >> ~/.profile; fi",
        "export PATH=\"/snap/bin:$PATH\""
      ],
      "validation": [
        "echo $PATH | grep /snap/bin"
      ]
    }
  },
  "git": {
    "ubuntu": {
      "manager": "apt",
      "pre": [
        "sudo add-apt-repository ppa:git-core/ppa -y",
        "sudo apt update"
      ],
      "post": [
        "git config --global core.eol lf",
        "git config --global core.autocrlf false"
      ],
      "package": "git",
      "validation": [
        "git --version"
      ]
    },
    "windows11": {
      "manager": "winget",
      "package": "Git.Git",
      "validation": [
        "git --version"
      ]
    }
  },
  "cargo": {
    "ubuntu": {
      "manager": "apt",
      "package": "cargo",
      "validation": [
        "cargo --version"
      ]
    }
  },
  "dotnet": {
    "ubuntu": {
      "manager": "apt",
      "pre": [
        "sudo add-apt-repository ppa:dotnet/backports -y",
        "sudo apt update"
      ],
      "package": "dotnet-sdk-10.0",
      "validation": [
        "dotnet --info"
      ]
    },
    "windows11": {
      "manager": "winget",
      "package": "Microsoft.DotNet.SDK.8",
      "validation": [
        "dotnet --info"
      ]
    }
  },
  "neovim": {
    "ubuntu": {
      "manager": "snap",
      "package": "nvim",
      "flags": [
        "--classic"
      ],
      "validation": [
        "nvim --version"
      ]
    }
  },
  "nushell": {
    "ubuntu": {
      "manager": "snap",
      "package": "nushell",
      "flags": [
        "--classic"
      ],
      "validation": [
        "nu --version"
      ]
    },
    "windows11": {
      "manager": "winget",
      "package": "Nushell.Nushell",
      "validation": [
        "nu --version"
      ]
    }
  },
  "ghostty": {
